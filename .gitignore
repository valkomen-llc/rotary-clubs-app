# Dependencies
node_modules/
dist/
dist-ssr/
*.local

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Databases (SQLite)
*.db
*.db-journal

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vite & Vercel
*.timestamp-*
.vercel
.env*.local
.env.prod

# App Specific Ignores
.agent/
scratch/
tmp/
*.txt
*.py
*.cjs
*.mjs
# Los guardianes del despliegue SÍ van al repositorio: sin ellos el
# `prebuild` falla y, peor, se pierde la protección contra el borrado de datos.
!scripts/*.mjs
# Y los datos de prueba que esos guiones necesitan. La negación de arriba no
# alcanza a los subdirectorios, así que sin esta línea una prueba se sube sin
# su fixture y falla en cualquier clon.
!scripts/fixtures/*.mjs
check_*.js
test_*.js
test-*.js
siteimages.json
colrotarios.json
components.json
event.json
temp.json
*.jpg
*.png
!public/*.png
!public/*.jpg
!public/defaults/**/*.png
!public/defaults/**/*.jpg

.env.production
