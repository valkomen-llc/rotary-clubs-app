# Base de datos (Postgres para producción, SQLite para local)
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/DATABASE"

# Secreto para JWT
JWT_SECRET=tu_secreta_aqui

# URL de la API del Frontend (para CORS)
CLIENT_URL=http://localhost:5173

# Puerto del Servidor
PORT=5001

# API URL para el Frontend (Vite)
VITE_API_URL=http://localhost:5001/api

# ── Modelos de IA (al menos uno requerido para ProyectIA) ──────────────────────
# Google Gemini (recomendado — gratuito con límites generosos)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# OpenAI (GPT-4o, GPT-4o Mini)
OPENAI_API_KEY=tu_openai_api_key_aqui

# Anthropic Claude (3.5 Sonnet, Haiku)
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui

# Mistral AI
MISTRAL_API_KEY=tu_mistral_api_key_aqui

# Clave para cifrar API Keys guardadas en BD (cualquier string seguro de 32 chars)
AI_KEY_SECRET=cambia_esto_por_un_string_secreto_32chars

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────────
# Obtener en: developers.facebook.com → Tu App → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=           # ID del número de teléfono del negocio (ej. 123456789)
WA_WABA_ID=                   # WhatsApp Business Account ID
WA_ACCESS_TOKEN=              # System User Token permanente (no expira)
WA_VERIFY_TOKEN=rotary_webhook_secret_2026  # Token secreto para validar el webhook
WA_APP_ID=                    # Meta App ID (opcional)
WA_API_VERSION=v19.0          # Versión de la Graph API

# ── WhatsApp QR Gateway (Evolution API) ────────────────────────────────────────
# Gateway nativo vía sesión QR para el SuperAdmin de Club Platform.
# Evolution API se despliega aparte (Docker): https://github.com/EvolutionAPI/evolution-api
EVOLUTION_API_URL=            # URL pública de la instancia Evolution (ej. https://evo.clubplatform.org)
EVOLUTION_API_KEY=            # API key global configurada en Evolution
EVOLUTION_INSTANCE_NAME=clubplatform-admin  # Nombre de la instancia (línea única de SuperAdmin)

# ── Creador de Reels IA ────────────────────────────────────────────────────────
# Tres fotos → tres clips image-to-video → montaje con música y locución.
# Cada motor tiene su responsabilidad y su credencial; ninguna es obligatoria
# salvo KIE_API_KEY (video) y una de copy, que la plataforma ya usa en otros
# módulos. Ver la sección "Creador de Reels IA" en CLAUDE.md.

# Video: KIE.AI anima las fotos y adapta el lienzo. NO genera voz ni música.
KIE_API_KEY=                  # Ya usada por el Generador de Publicaciones y Outros
REEL_DEFAULT_ENGINE=          # kling26 (por defecto) | kling21 | seedance | minimax
REEL_MODEL_KLING26=           # Corregir el id de un modelo sin desplegar

# Montaje: FFmpeg viaja con la aplicación; los alojados son opcionales.
REEL_RENDER_PROVIDER=         # ffmpeg (por defecto) | shotstack | creatomate | json2video
REEL_RENDER_FALLBACK=         # Proveedor de respaldo si el principal falla
FFMPEG_PATH=                  # Apuntar a un ffmpeg del sistema en vez del empaquetado

# Audio: ElevenLabs pone la voz y la música. Una sola credencial para las dos.
ELEVENLABS_API_KEY=           # Text to Speech + Music Generation + Voices (lectura)
ELEVENLABS_VOICE_FEMALE=      # Voice ID de la voz femenina (acento latino real)
ELEVENLABS_VOICE_MALE=        # Voice ID de la voz masculina
ELEVENLABS_MODEL=             # eleven_multilingual_v2 por defecto
ELEVENLABS_MUSIC_MODEL=       # music_v1 por defecto
REEL_TTS_PROVIDER=            # elevenlabs | openai — vacío: el que tenga credencial
REEL_MUSIC_PROVIDER=          # Fuerza un motor de música concreto (sin respaldo)
STABILITY_API_KEY=            # Stable Audio, respaldo de música

# Expansión Inteligente del lienzo antes de animar.
EXPANSION_PROVIDER=           # nano_banana por defecto
EXPANSION_MIN_PRESERVATION=   # 0-1, 0.82 por defecto

# Frenos de gasto y auditoría de consumo (v4.669).
REEL_MONTHLY_CREDIT_LIMIT=    # Tope mensual de créditos estimados
REEL_CREDITS_EXPANSION=       # Créditos estimados por adaptación de lienzo (4 por defecto)
# Tarifas del panel de auditoría. SIN estas variables el panel muestra tiempo y
# unidades —que son medidas reales— pero no costo en dinero: no se inventa un
# precio por defecto porque depende del plan de cada cuenta.
REEL_RATE_KIE_CREDIT_USD=     # USD por crédito de KIE
REEL_RATE_ELEVENLABS_CHARS_USD=  # USD por cada 1.000 caracteres de locución
REEL_RATE_MUSIC_SECOND_USD=   # USD por segundo de música generada
REEL_RATE_LLM_TOKENS_USD=     # USD por cada 1.000 tokens del modelo de lenguaje
