{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.js"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-activations",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/send-scheduled-emails",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/refresh-dossiers",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/training-reminders",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/reels-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/crm-automation-tick",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/seo-tick",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/emergency-feed",
      "schedule": "*/15 * * * *"
    }
  ]
}
